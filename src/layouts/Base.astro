---
import type { Lang } from '../data/works';
import { STRINGS, localePath } from '../data/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string; // 언어 접두어 없는 경로, 언어 전환 링크에 씀. 언어판이 하나뿐인 법적 고지는 비운다
  bodyClass?: string;
  // 공유 미리보기 그림. 없으면 로고
  ogImage?: string;
  // 언어판이 없는 페이지는 그 언어로 바꿀 때 갈 경로를 따로 준다. 준 언어는 hreflang을 달지 않는다
  altPath?: Partial<Record<Lang, string>>;
}
const { lang, title, description, path, bodyClass, ogImage = '/img/logo1.png', altPath } = Astro.props;
const LANGS: readonly Lang[] = ['ko', 'en'];
const t = STRINGS[lang];
const targetOf = (l: Lang): string => altPath?.[l] ?? path ?? '/';
const pairs = LANGS.filter((l) => path && !altPath?.[l]);
// 현재 위치는 색과 함께 aria-current로도 알린다. 작품 상세는 게임과 앱 아래로 본다
const here = path ?? '';
const isBlog = here.startsWith('/blog/');
const nav = [
  { href: '/works/', label: 'Works', full: t.works, on: here !== '' && !isBlog && !['/', '/about/', '/contact/'].includes(here) },
  { href: '/blog/', label: 'Blog', full: t.blog, on: isBlog },
  { href: '/about/', label: 'About', full: t.about, on: here === '/about/' },
  { href: '/contact/', label: 'Contact', full: t.contact, on: here === '/contact/' },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {pairs.length > 1 && pairs.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, targetOf(l)), Astro.site)}>)}
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.site)}>
  <link rel="icon" href="/img/ww3.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
</head>
<body class={bodyClass}>
  <header class="topbar">
    <a href={localePath(lang, '/')} class="topbar-logo"><img src="/img/logo1.png" alt="WaveWorks" width="600" height="390"></a>
    <nav class="topbar-nav">
      {nav.map((n) => <a href={localePath(lang, n.href)} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <!-- 좁은 화면은 위 메뉴 대신 접히는 메뉴. 스크립트 없이 열고 닫힌다 -->
    <details class="topbar-menu">
      <summary>{t.menu}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></summary>
      <nav>
        {nav.map((n) => <a href={localePath(lang, n.href)} aria-current={n.on ? 'page' : undefined}>{n.full}</a>)}
      </nav>
    </details>
    {path && (
      <div class="lang-menu">
        <button type="button" class="lang-btn" aria-expanded="false" aria-label={t.language}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9.5" /><ellipse cx="12" cy="12" rx="4.2" ry="9.5" /><path d="M2.5 12h19" /></g></svg>
        </button>
        <ul class="lang-list">
          {LANGS.map((l) => <li><a href={localePath(l, targetOf(l))} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>)}
        </ul>
      </div>
    )}
  </header>
  <slot />
  <script>
    // 첫 화면을 지나면 상단 막대에 바탕을 깔아 글이 겹치지 않게 한다
    const bar = document.querySelector('.topbar');
    const sync = () => bar?.classList.toggle('scrolled', window.scrollY > 40);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    // 언어 목록은 마우스를 올리거나 버튼을 누르면 펼쳐진다. 탭으로 여는 휴대폰을 위해 누름도 받는다
    const langMenu = document.querySelector('.lang-menu');
    const langBtn = langMenu?.querySelector('.lang-btn');
    const setLang = (open: boolean) => { langMenu?.classList.toggle('open', open); langBtn?.setAttribute('aria-expanded', String(open)); };
    langBtn?.addEventListener('click', () => setLang(!langMenu?.classList.contains('open')));
    document.addEventListener('click', (e) => { if (!langMenu?.contains(e.target as Node)) setLang(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setLang(false); });
  </script>
</body>
</html>
