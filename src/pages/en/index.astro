---
import Base from '../../layouts/Base.astro';
import HomeIntro from '../../components/HomeIntro.astro';
import Home from '../../components/Home.astro';
import { STRINGS } from '../../data/i18n';
import { homeLd } from '../../data/seo';

const t = STRINGS.en;
---
<Base lang="en" title={t.homeTitle} description={t.homeDesc} path="/" jsonLd={homeLd(Astro.site, 'en')}>
  <HomeIntro lang="en" />
  <Home lang="en" />
</Base>
