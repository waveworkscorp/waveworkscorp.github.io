---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import WorkDetail from '../components/WorkDetail.astro';
import { WORKS, type Work } from '../data/works';
import { workLd } from '../data/seo';
import { buildFaq } from '../lib/faq-core';

export const getStaticPaths = (() => WORKS.map((work) => ({ params: { slug: work.slug }, props: { work } }))) satisfies GetStaticPaths;

interface Props { work: Work }
const { work } = Astro.props;
// 새 앱이 질문표에 없는 info 라벨을 쓰면 빌드 때 알린다. 그 줄은 FAQ에서 빠지고 빌드는 계속된다. 같은 줄이 두 번 나오지 않게 한국어 페이지에서만 알린다
buildFaq(work, 'ko').unknownLabels.forEach((label) => console.warn(`[faq] ${work.slug}: 질문표(src/lib/faq-core.ts)에 없는 info 라벨 "${label}"`));
---
<Base lang="ko" title={`${work.name.ko} | WaveWorks`} description={work.about.ko} path={`/${work.slug}/`} jsonLd={workLd(Astro.site, 'ko', work)}>
  <WorkDetail lang="ko" work={work} />
</Base>
