---
import type { LegalPage } from '../data/legal';
import SiteFooter from './SiteFooter.astro';
import { localePath } from '../data/i18n';

interface Props { page: LegalPage }
const { page } = Astro.props;
const backLabel = page.lang === 'ko' ? '이전으로' : 'Back';
---
<main class="legal">
  <section class="band">
    <img class="buddy" src="/img/mascot-about.png" alt="" width="640" height="640" aria-hidden="true" />
    <a class="back" href={page.back ?? localePath(page.lang, '/works/')} data-history={page.back ? undefined : ''}>
      <span aria-hidden="true">←</span>{backLabel}
    </a>
    <h1 set:html={page.heading} />
    {page.links.length > 0 && (
      <nav class="docs">
        {page.links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    )}
    <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#fff" d="M0 80V40c120-36 240-36 360 0s240 36 360 0 240-36 360 0 240 36 360 0v40z" />
    </svg>
  </section>

  <article class="sheet" set:html={page.body} />
</main>
<SiteFooter lang={page.lang} />

<script>
  // 여러 게임이 같이 쓰는 문서는 어느 게임에서 왔는지 모르니, 사이트 안에서 왔으면 그 화면으로 돌아간다
  const back = document.querySelector<HTMLAnchorElement>('.back[data-history]');
  back?.addEventListener('click', (e) => {
    if (!document.referrer.startsWith(location.origin)) return;
    e.preventDefault();
    history.back();
  });
</script>

<style>
  /* 법적 고지: 하늘색 띠에 제목과 문서 탭, 아래는 테두리 친 종이 한 장 */
  .band {
    position: relative; overflow: hidden; padding: 128px clamp(20px, 6vw, 96px) 120px;
    background: radial-gradient(rgba(255,255,255,.35) 2.5px, transparent 3.5px) 0 0 / 26px 26px, var(--sky);
  }
  h1 {
    position: relative; z-index: 1; max-width: 15em; margin: 0;
    font: 400 clamp(36px, 5.4vw, 72px)/1.12 var(--font-ko-display); word-break: keep-all;
  }
  :global(html[lang='en']) h1 { font-family: var(--font-en-display); font-weight: 700; letter-spacing: -.01em; }
  .buddy {
    position: absolute; right: clamp(16px, 7vw, 120px); bottom: 40px; width: clamp(110px, 15vw, 220px);
    animation: hop 3s ease-in-out infinite;
  }
  @keyframes hop { 0%, 100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-16px) rotate(5deg); } }
  .docs { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; max-width: 70%; }
  .docs a {
    font-weight: 800; font-size: 15px; text-decoration: none; background: #fff;
    border: var(--line); border-radius: 99px; padding: 6px 18px; box-shadow: 3px 3px 0 var(--ink);
    transition: transform .12s ease-out, box-shadow .12s ease-out;
  }
  .docs a:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .docs a[aria-current='page'] { background: var(--sun); }
  .back {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 22px;
    font-weight: 800; font-size: 16px; text-decoration: none; background: #fff;
    border: var(--line); border-radius: 99px; padding: 7px 20px 7px 14px; box-shadow: 3px 3px 0 var(--ink);
    transition: transform .12s ease-out, box-shadow .12s ease-out;
  }
  .back:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .back span { font-size: 18px; }
  .edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; }

  .sheet {
    max-width: 860px; margin: -40px auto 0; position: relative; z-index: 1;
    background: #fff; border: 4px solid var(--ink); border-radius: 32px; box-shadow: 10px 10px 0 var(--ink);
    padding: clamp(28px, 5vw, 56px); font-size: 16px; line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere;
  }
  .sheet :global(> :first-child) { margin-top: 0; }
  .sheet :global(h2) {
    /* 형광펜을 배경 대신 굵은 밑줄로 그어 두 줄로 넘어가는 긴 영어 제목도 줄마다 칠해지게 한다 */
    margin: 48px 0 8px; font: 400 clamp(26px, 3vw, 36px)/1.3 var(--font-ko-display);
    text-decoration: underline var(--sun); text-decoration-thickness: .42em; text-underline-offset: -.3em; text-decoration-skip-ink: none;
  }
  :global(html[lang='en']) .sheet :global(h2) { font-family: var(--font-en-display); font-weight: 700; }
  .sheet :global(h3) { position: relative; margin: 32px 0 6px; padding-left: 22px; font-size: 19px; font-weight: 800; }
  .sheet :global(h3)::before {
    content: ''; position: absolute; left: 0; top: .42em; width: 12px; height: 12px;
    background: var(--wave); border: 2px solid var(--ink); border-radius: 50%;
  }
  .sheet :global(p), .sheet :global(li) { color: #2b3666; }
  .sheet :global(ul), .sheet :global(ol) { padding-left: 1.3em; }
  .sheet :global(li) { margin: 4px 0; }
  .sheet :global(li::marker) { color: var(--wave); }
  .sheet :global(a) { color: var(--wave); font-weight: 700; text-underline-offset: 3px; }
  .sheet :global(.muted), .sheet :global(.meta) {
    display: block; width: fit-content; font-size: 14px; font-weight: 700; background: #eef7ff;
    border: 2px solid var(--ink); border-radius: 12px; padding: 6px 14px;
  }
  .sheet :global(.table-wrap) { overflow-x: auto; margin: 14px 0; }
  .sheet :global(table) {
    width: 100%; border-collapse: separate; border-spacing: 0; font-size: 15px; margin: 14px 0;
    border: 3px solid var(--ink); border-radius: 16px; overflow: hidden;
  }
  .sheet :global(.table-wrap table) { margin: 0; }
  .sheet :global(th), .sheet :global(td) { padding: 10px 12px; text-align: left; vertical-align: top; border-bottom: 2px solid #d9e3f5; }
  .sheet :global(th) { background: var(--sky); font-weight: 800; border-bottom: 3px solid var(--ink); }
  .sheet :global(tr:last-child td) { border-bottom: 0; }
  .sheet :global(code) { background: #eef7ff; border-radius: 6px; padding: 0 5px; }
  .sheet :global(footer) { margin-top: 40px; padding-top: 16px; border-top: 2px dashed var(--ink); font-size: 14px; opacity: .7; }
  /* 목록 페이지(요괴 사냥꾼)의 문서 링크 묶음 */
  .sheet :global(ul:not(:has(li > p)) > li > a:only-child) { display: inline-block; padding: 4px 0; }

  @media (max-width: 860px) {
    .band { padding: 104px 24px 140px; }
    .docs { max-width: none; }
    .buddy { width: 84px; top: 84px; bottom: auto; }
    .sheet { margin: -60px 16px 0; border-radius: 24px; box-shadow: 6px 6px 0 var(--ink); }
  }
</style>
