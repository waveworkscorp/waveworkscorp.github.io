---
import type { Lang } from '../data/works';
import { WORKS, isAvailable } from '../data/works';
import { localePath } from '../data/i18n';
import { ABOUT } from '../data/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ABOUT[lang].story;

const nameOf = (slug: string): string => WORKS.find((w) => w.slug === slug)?.name[lang] ?? slug;
// How We Move 카드 순서와 같다
const MOVE_IMAGES = ['beyond', 'fail', 'momentum', 'immerse', 'together'].map((n) => `/img/move-${n}.png`);
const pending = WORKS.filter((w) => !isAvailable(w)).map((w) => w.name[lang]).join(' · ');
---
<section class="story" aria-labelledby="story-head">
  <div class="manifesto">
    <h2 id="story-head" class="big">{s.big[0]}<br />{s.big[1]}</h2>
    <p class="kor"><span>{s.sub}</span></p>
  </div>

  <div class="say">
    <p class="say-head">{s.say.map((part, i) => (i % 2 ? <b>{part}</b> : part))}</p>
    <p>{s.body}</p>
    <p class="hl">{s.highlight}</p>
  </div>

  <div class="num">
    <h3>{s.numHead}</h3>
    <p class="huge"><em>{s.num}</em>{s.numUnit}</p>
  </div>

  <div class="cycle">
    <p class="cycle-head">{s.cycleHead}</p>
    <h3>{s.cycleTitle[0]}<em>{s.cycleTitle[1].split(/(\d+)/).map((part) => (/^\d+$/.test(part) ? <span class="digit">{part}</span> : part))}</em></h3>
    <div class="steps-wrap">
      <svg viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 20 Q 62 0 125 20 T 250 20 T 375 20 T 500 20 T 625 20 T 750 20 T 875 20 T 1000 20" fill="none" stroke="var(--ink)" stroke-width="4" stroke-dasharray="10 10" /></svg>
      <ol class="steps">
      {s.steps.map((st, i) => (
        <li class="step"><i>{i + 1}</i><div><b>{st.title}</b><p>{st.body}</p></div></li>
      ))}
      </ol>
    </div>
  </div>

  <div class="moves">
    <h3>{s.moveHead}</h3>
    <div class="cards-wrap">
      <ul class="cards">
        {s.moves.map((m, i) => (
          <li class="card" tabindex="0">
            <div class="flip">
              <div class="face front">
                <p class="t">{m.title[0]}<br />{m.title[1]}</p>
                <p class="sub">{m.sub}</p>
                <img src={MOVE_IMAGES[i]} alt="" width="640" height="640" loading="lazy" />
                <span class="plus" aria-hidden="true"></span>
              </div>
              <div class="face back">
                <img src={MOVE_IMAGES[i]} alt="" width="640" height="640" loading="lazy" />
                <div class="back-text">
                  <p class="t">{m.title[0]} {m.title[1]}</p>
                  <p class="sub">{m.sub}</p>
                  <p class="desc">{m.body}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <button type="button" class="next" aria-label={lang === 'ko' ? '다음 카드' : 'Next card'}></button>
    </div>
  </div>

  <div class="history">
    <h3>HISTORY</h3>
    <ol class="tl">
      {s.history.map((y, yi) => (
        <li>
          <span class="y">{y.year}</span>
          <ul>
            {yi === 0 && pending && <li class="soon"><span class="m">··</span><span>{pending} {s.soon}</span></li>}
            {y.items.map((it) => (
              <li>
                <span class="m">{it.month}</span>
                <span>{'slug' in it ? <><a href={localePath(lang, `/${it.slug}/`)}>[{nameOf(it.slug)}]</a> {it.text}</> : it.text}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <img class="mascot" src="/img/mascot-about.png" alt="" width="1024" height="1024" loading="lazy" />
  </div>
</section>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.moves .next')) {
    const list = btn.parentElement?.querySelector<HTMLElement>('.cards');
    btn.addEventListener('click', () => list?.scrollBy({ left: 320, behavior: 'smooth' }));
  }
</script>

<style>
  .story { max-width: 1240px; margin: 0 auto; padding: 120px 20px 0; }
  :global(html[lang='en']) .story h3, :global(html[lang='en']) .step b { font-family: var(--font-en-display); font-weight: 700; }

  .manifesto { text-align: center; }
  .big { margin: 0; font: 700 clamp(46px, 7.4vw, 104px)/1 var(--font-en-display); letter-spacing: -.02em; }
  .kor { margin: 26px 0 0; font: 400 clamp(40px, 6vw, 84px)/1.1 var(--font-ko-display); }
  .kor span {
    display: inline-block; padding: .14em .4em .18em; color: #fff; background: var(--wave);
    border: var(--line); border-radius: 26px; box-shadow: var(--pop); transform: rotate(-2deg);
  }
  :global(html[lang='en']) .kor { font-family: var(--font-en-display); font-weight: 700; }

  .say { margin: 70px auto 0; max-width: 820px; text-align: center; }
  .say p { margin: 22px 0 0; font-size: 18px; font-weight: 500; opacity: .75; }
  .say .say-head { margin: 0; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.45; font-weight: 700; opacity: 1; }
  .say-head b { background: linear-gradient(transparent 58%, var(--sun) 58%); }
  .say .hl {
    display: inline-block; margin-top: 30px; font-weight: 800; font-size: clamp(20px, 2.2vw, 26px); opacity: 1;
    background: var(--sky); border: var(--line); border-radius: 18px; padding: 12px 24px; box-shadow: 4px 4px 0 var(--ink);
  }

  .num { margin-top: 120px; text-align: center; }
  .num h3 { margin: 0; font: 400 clamp(30px, 4vw, 54px) var(--font-ko-display); }
  .huge {
    display: inline-block; margin: 18px 0 0; font: 400 clamp(110px, 18vw, 230px)/1 var(--font-ko-display); color: #fff;
    -webkit-text-stroke: 5px var(--ink); paint-order: stroke fill; text-shadow: 10px 10px 0 var(--ink);
  }
  :global(html[lang='en']) .huge { font-family: var(--font-en-display); font-weight: 700; font-size: clamp(90px, 14vw, 190px); }
  .huge em { font-style: normal; color: var(--sun); }
  /* Black Han Sans의 숫자는 한글보다 14%쯤 낮게 그려져, 숫자만 키워 글자 높이를 맞춘다 */
  .huge em, .digit { font-size: 1.16em; line-height: .8; }
  :global(html[lang='en']) .huge em, :global(html[lang='en']) .digit { font-size: 1em; }

  .cycle { margin-top: 130px; text-align: center; }
  .cycle-head { margin: 0; font-size: 22px; font-weight: 700; }
  .cycle h3 { margin: 6px 0 0; font: 400 clamp(34px, 4.6vw, 62px)/1.1 var(--font-ko-display); }
  .cycle h3 em { font-style: normal; color: var(--wave); }
  .steps-wrap { position: relative; margin-top: 60px; }
  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; text-align: left; }
  .steps-wrap svg { position: absolute; left: 0; top: 15px; width: 100%; height: 40px; }
  .step { position: relative; }
  .step i {
    display: grid; place-items: center; width: 70px; height: 70px; margin: 0 auto 16px; border: var(--line); border-radius: 50%;
    box-shadow: 4px 4px 0 var(--ink); font: 700 30px var(--font-en-display); font-style: normal; background: var(--sun);
  }
  .step:nth-child(2) i { background: var(--sky); }
  .step:nth-child(3) i { background: var(--coral); color: #fff; }
  .step:nth-child(4) i { background: var(--tang); color: #fff; }
  .step div { border: var(--line); border-radius: 22px; padding: 18px 20px; background: #fff; box-shadow: 4px 4px 0 var(--ink); min-height: 150px; }
  .step b { font: 400 26px var(--font-ko-display); }
  .step p { margin: 6px 0 0; font-size: 15px; font-weight: 600; opacity: .78; }

  .moves { margin-top: 130px; }
  .moves h3 { margin: 0 0 40px; text-align: center; font: 700 clamp(46px, 6vw, 80px)/1 var(--font-en-display); }
  .cards-wrap { position: relative; }
  .cards {
    list-style: none; margin: 0; padding: 4px 4px 18px; display: flex; gap: 24px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .cards::-webkit-scrollbar { display: none; }
  .card { flex: 0 0 300px; height: 420px; perspective: 1000px; scroll-snap-align: start; outline: none; }
  .flip { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .3s cubic-bezier(.4, 0, .2, 1); }
  .card:hover .flip, .card:focus-within .flip, .card:focus .flip { transform: rotateY(180deg); }
  .face {
    position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border: var(--line); border-radius: 34px; box-shadow: 5px 5px 0 var(--ink); background: var(--c1);
    background-image: radial-gradient(rgba(255,255,255,.3) 2px, transparent 3px), linear-gradient(170deg, var(--c1) 30%, var(--c2));
    background-size: 22px 22px, auto;
  }
  .card:nth-child(1) { --c1: #ffe27a; --c2: var(--sun); }
  .card:nth-child(2) { --c1: #b8ecff; --c2: var(--sky); }
  .card:nth-child(3) { --c1: #ffb0ba; --c2: var(--coral); }
  .card:nth-child(4) { --c1: #8fc2ff; --c2: var(--wave); }
  .card:nth-child(5) { --c1: #ffc08a; --c2: var(--tang); }
  .front { display: flex; flex-direction: column; align-items: center; padding-top: 40px; text-align: center; }
  .front .t { margin: 0; font: 700 32px/1.1 var(--font-en-display); }
  .front .sub { margin: 8px 0 0; font-size: 14px; font-weight: 700; }
  .front img { position: absolute; left: 50%; bottom: 10px; width: 250px; height: 250px; object-fit: contain; translate: -50% 0; pointer-events: none; }
  .plus { position: absolute; right: 22px; bottom: 22px; width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--ink); background: #fff; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 3px; background: var(--ink); translate: -50% -50%; }
  .plus::after { rotate: 90deg; }
  .back { transform: rotateY(180deg); color: #fff; }
  .back img { position: absolute; left: 50%; bottom: 10px; width: 250px; height: 250px; object-fit: contain; translate: -50% 0; filter: blur(25px); pointer-events: none; }
  .back::after { content: ''; position: absolute; inset: 0; background: rgba(22, 34, 79, .55); }
  .back-text { position: relative; z-index: 1; padding: 40px 26px 0; }
  .back .t { margin: 0; font: 700 26px/1.2 var(--font-en-display); }
  .back .sub { margin: 6px 0 0; font-size: 16px; font-weight: 700; }
  .back .desc { margin: 16px 0 0; font-size: 15px; font-weight: 500; line-height: 1.7; opacity: .92; }
  .next {
    position: absolute; right: -8px; top: 50%; translate: 0 -50%; width: 52px; height: 52px; border-radius: 50%; cursor: pointer;
    background: #fff; border: var(--line); box-shadow: 3px 3px 0 var(--ink);
  }
  .next::before { content: ''; position: absolute; left: 15px; top: 16px; width: 14px; height: 14px; border: solid var(--ink); border-width: 4px 4px 0 0; rotate: 45deg; }
  @media (prefers-reduced-motion: reduce) { .flip { transition: none; } }

  .history {
    position: relative; overflow: hidden; margin-top: 130px; padding: 60px clamp(22px, 5vw, 70px) 70px;
    background: radial-gradient(rgba(255,255,255,.35) 2.5px, transparent 3.5px) 0 0 / 26px 26px, var(--sun);
    border: 4px solid var(--ink); border-radius: 44px; box-shadow: var(--pop);
  }
  .history h3 { margin: 0 0 40px; text-align: center; font: 700 clamp(46px, 6vw, 80px)/1 var(--font-en-display); }
  .mascot { position: absolute; right: 30px; bottom: 20px; width: 180px; height: auto; }
  .tl { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; max-width: 760px; }
  .tl > li { display: grid; grid-template-columns: 120px 1fr; gap: 28px; }
  .y { font: 700 44px/1 var(--font-en-display); text-align: right; }
  .tl ul { list-style: none; margin: 0; padding: 0 0 0 28px; border-left: 4px solid var(--ink); display: grid; gap: 14px; }
  .tl ul li { position: relative; display: flex; gap: 18px; font-size: 19px; font-weight: 700; }
  .tl ul li::before {
    content: ''; position: absolute; left: -38px; top: 8px; width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 3px solid var(--ink);
  }
  .m { font: 700 19px var(--font-en-display); min-width: 28px; flex: none; }
  .tl a { color: inherit; font-weight: 800; }
  .tl .soon { font-weight: 600; opacity: .75; }

  @media (max-width: 860px) {
    .steps {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 0 -20px; padding: 4px 20px 14px; scroll-padding: 0 20px;
    }
    .steps::-webkit-scrollbar { display: none; }
    .step { flex: 0 0 260px; scroll-snap-align: start; }
    .steps-wrap svg, .mascot, .next { display: none; }
    .card { flex-basis: 270px; height: 400px; }
    .cards { margin: 0 -20px; padding: 4px 20px 18px; scroll-padding: 0 20px; }
    .tl > li { grid-template-columns: 1fr; gap: 12px; }
    .y { text-align: left; }
  }
</style>
