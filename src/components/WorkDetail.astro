---
import type { Lang, Work } from '../data/works';
import { STRINGS, localePath } from '../data/i18n';
import SiteFooter from './SiteFooter.astro';

interface Props { lang: Lang; work: Work }
const { lang, work: w } = Astro.props;
const t = STRINGS[lang];

// 바탕이 어두운 작품은 글자를 흰색으로
const DARK_LUMA = 0.45;
const hex = w.accent.slice(1);
const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
const isDark = 0.2126 * r + 0.7152 * g + 0.0722 * b < DARK_LUMA;

const stores = [
  { key: 'play', label: 'Google Play', href: w.stores.play },
  { key: 'appStore', label: 'App Store', href: w.stores.appStore },
] as const;

const listHref = localePath(lang, '/works/');

const docs = [
  { label: t.privacy, href: w.privacy[lang], img: '/img/island-about.png' },
  ...(w.terms ? [{ label: t.terms, href: w.terms[lang], img: '/img/island-works.png' }] : []),
  ...(w.deletion ? [{ label: t.deletion, href: w.deletion[lang], img: '/img/island-contact.png' }] : []),
  { label: t.support, href: `${localePath(lang, '/contact/')}?app=${w.slug}`, img: '/img/mascot-contact.png' },
];
---
<main>
  <section class:list={['hero', { dark: isDark }]} style={`--accent:${w.accent};--bg:url(/img/hero/${w.slug}.jpg)`}>
    <div class="copy">
      <a class="back" href={listHref} data-back>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {t.backToWorks}
      </a>
      <img class="icon" src={w.icon} alt="" width="512" height="512" style={`view-transition-name:work-${w.slug}`} />
      <h1>{w.name[lang]}</h1>
      <p class="tagline">{w.tagline[lang]}</p>
      <div class="stores" aria-label={t.getOn}>
        {stores.map((s) => s.href
          ? <a class="store" href={s.href} rel="noopener">{s.label}</a>
          : <span class="store off">{s.label}<small>{t.comingSoon}</small></span>)}
      </div>
    </div>
    <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#fff" d="M0 80V40c120-36 240-36 360 0s240 36 360 0 240-36 360 0 240 36 360 0v40z" />
    </svg>
  </section>

  <div class="body">
    <section class="intro" aria-labelledby="feat-head">
      <p class="about">{w.about[lang]}</p>
      <h2 id="feat-head">{t.featuresHead}</h2>
      <ul class="features" style={`--accent:${w.accent}`}>
        {w.features.map((f) => (
          <li><b>{f.title[lang]}</b><span>{f.body[lang]}</span></li>
        ))}
      </ul>
    </section>

    {w.shots > 0 && (
      <section class="screens" aria-labelledby="shots-head">
        <h2 id="shots-head">{t.screensHead}</h2>
        <div class="strip">
          {Array.from({ length: w.shots }, (_, i) => (
            <img src={`/img/shots/${w.slug}/${lang}-${i + 1}.jpg`} alt={`${w.name[lang]} ${i + 1}`} width="480" loading="lazy" />
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="docs-head">
      <h2 id="docs-head">{t.docs}</h2>
      <div class="docs">
        {docs.map((d) => (
          <a class="doc" href={d.href}>
            <img src={d.img} alt="" width="640" height="640" loading="lazy" />
            <span>{d.label}</span>
          </a>
        ))}
      </div>
    </section>

    <a class="all" href={listHref} data-back>{t.allWorks}</a>
  </div>
</main>

<script>
  // 목록에서 들어왔으면 뒤로 가기로 돌아가 목록의 스크롤 위치와 탭을 그대로 살린다
  document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach((a) => a.addEventListener('click', (e) => {
    const from = document.referrer ? new URL(document.referrer) : null;
    const target = new URL(a.href);
    if (from && from.origin === location.origin && from.pathname === target.pathname) {
      e.preventDefault();
      history.back();
    }
  }));
</script>
<SiteFooter lang={lang} />

<style>
  /* 게임 장면 그림을 화면 가득 깔고, 글이 놓이는 왼쪽만 대표색으로 덮어 읽히게 한다 */
  .hero {
    position: relative; overflow: hidden; display: flex; align-items: center;
    min-height: min(88svh, 820px); padding: 120px clamp(20px, 6vw, 96px) 140px;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 92%, transparent) 0%, color-mix(in srgb, var(--accent) 55%, transparent) 38%, transparent 62%),
      var(--bg) right center / cover no-repeat,
      var(--accent);
  }
  .dark { color: #fff; }
  .copy { position: relative; z-index: 1; max-width: 620px; }
  .back {
    display: inline-flex; align-items: center; gap: 6px; margin-bottom: 26px; font-weight: 800; font-size: 16px; text-decoration: none;
    background: #fff; color: var(--ink); border: var(--line); border-radius: 99px; padding: 8px 20px 8px 14px;
    box-shadow: 4px 4px 0 var(--ink); transition: transform .12s ease-out;
  }
  .back:hover { transform: translateX(-4px); }
  .icon { width: 108px; border: 4px solid var(--ink); border-radius: 26%; box-shadow: var(--pop); transform: rotate(-4deg); }
  h1 { margin: 22px 0 0; font: 400 clamp(48px, 6.6vw, 100px)/1.02 var(--font-ko-display); }
  :global(html[lang='en']) h1 { font-family: var(--font-en-display); font-weight: 700; letter-spacing: -.02em; }
  .tagline { font-size: clamp(18px, 1.8vw, 23px); font-weight: 700; margin: 14px 0 30px; }
  .stores { display: flex; flex-wrap: wrap; gap: 12px; }
  .store {
    display: inline-flex; flex-direction: column; justify-content: center; min-width: 170px; min-height: 60px;
    font: 700 19px/1.15 var(--font-en-display); text-decoration: none; color: #fff;
    background: var(--ink); border: 3px solid var(--ink); border-radius: 16px; padding: 8px 20px; box-shadow: 5px 5px 0 rgba(22, 34, 79, .35);
  }
  a.store:hover { transform: translate(-2px, -2px); }
  .store.off { background: #fff; color: var(--ink); }
  .store small { font: 700 12px var(--font-body); opacity: .65; }

  .edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; }

  .body { max-width: 1240px; margin: 0 auto; padding: 40px 20px 0; }
  .about { font-size: clamp(20px, 2.2vw, 28px); font-weight: 700; line-height: 1.6; max-width: 32em; margin: 0 0 70px; }
  section + section { margin-top: 100px; }
  .features { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .features li {
    display: grid; gap: 4px; padding: 22px 26px 22px 70px; position: relative;
    background: #fff; border: var(--line); border-radius: 26px; box-shadow: var(--pop);
  }
  .features li::before {
    content: ''; position: absolute; left: 22px; top: 24px; width: 30px; height: 30px; border-radius: 50%;
    background: var(--accent); border: 3px solid var(--ink);
  }
  .features b { font-size: 21px; }
  .features span { font-weight: 600; opacity: .78; }

  /* 스토어 화면을 폰처럼 늘어놓고 옆으로 넘긴다 */
  .strip {
    display: flex; gap: 26px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 12px 6px 34px; margin: 0 -6px;
  }
  .strip img {
    flex: 0 0 auto; width: clamp(200px, 22vw, 270px); height: auto; scroll-snap-align: start;
    border: 5px solid var(--ink); border-radius: 30px; box-shadow: 8px 8px 0 var(--ink); background: var(--ink);
  }
  .strip img:nth-child(odd) { transform: rotate(-1.5deg); }
  .strip img:nth-child(even) { transform: rotate(1.5deg) translateY(14px); }
  h2 { margin: 0 0 30px; font: 400 clamp(34px, 4.4vw, 60px)/1.1 var(--font-ko-display); }
  :global(html[lang='en']) h2 { font-family: var(--font-en-display); font-weight: 700; }
  .docs { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 18px; }
  .doc {
    display: grid; justify-items: center; gap: 4px; text-decoration: none; text-align: center;
    background: var(--foam); border: var(--line); border-radius: 30px; padding: 22px 18px 24px; box-shadow: var(--pop);
    font-weight: 800; font-size: 18px; transition: transform .2s cubic-bezier(.3, 1.6, .5, 1);
  }
  .doc img { width: 62%; transition: transform .25s cubic-bezier(.3, 1.6, .5, 1); }
  .doc:hover { transform: translateY(-6px); }
  .doc:hover img { transform: translateY(-10px) rotate(-5deg); }

  .all {
    display: inline-block; margin-top: 80px; font-weight: 800; font-size: 18px; text-decoration: none; color: #fff;
    background: var(--wave); border: var(--line); border-radius: 18px; padding: 14px 28px; box-shadow: var(--pop);
  }
  .all:hover { transform: translate(-3px, -3px); }

  @media (max-width: 860px) {
    .features { grid-template-columns: 1fr; }
    .strip img { width: 62vw; }
    /* 좁은 화면은 그림을 위로 보이고 아래쪽을 대표색으로 덮어 글을 얹는다 */
    .hero {
      align-items: flex-end; min-height: 92svh; padding: 96px 24px 110px;
      background:
        linear-gradient(0deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 85%, transparent) 42%, transparent 70%),
        var(--bg) 72% center / cover no-repeat,
        var(--accent);
    }
    .icon { width: 84px; }
  }
</style>
