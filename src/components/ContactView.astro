---
import type { Lang } from '../data/works';
import { WORKS } from '../data/works';
import { COMPANY, CONTACT_ENDPOINT } from '../data/i18n';
import { CONTACT } from '../data/pages';
import SiteFooter from './SiteFooter.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = CONTACT[lang];

const kindImgs = ['/img/kind-help.png', '/img/kind-biz.png', '/img/kind-etc.png'];
---
<main>
  <section class="hero">
    <div class="copy">
      <p class="kicker">{c.title}</p>
      <h1>{c.hero.map((line, i) => <span class={`l${i}`}>{line}</span>)}</h1>
      <p class="lead">{c.lead}</p>
    </div>
    <img class="flyer" src="/img/contact-hero.png" alt="" width="720" height="720" />
    <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#fff" d="M0 80V40c120-36 240-36 360 0s240 36 360 0 240-36 360 0 240 36 360 0v40z" />
    </svg>
  </section>

  <!-- 스크립트가 문의를 공용 Apps Script 수신기로 보낸다. 스크립트가 꺼진 브라우저는 mailto로 메일 앱을 연다 -->
  <form class="form" novalidate data-err-required={c.errRequired} data-err-email={c.errEmail} action={`mailto:${COMPANY.email}`} method="post" enctype="text/plain"
    data-endpoint={CONTACT_ENDPOINT} data-lang={lang} data-sending={c.sending}
    data-to={COMPANY.email} data-prefix={c.subjectPrefix}>
    <h2 id="kind-head">{c.kindLabel}</h2>
    <!-- 고른 카드가 아래 폼에 붙은 탭이 된다. 그림자는 탭과 폼을 한 덩어리로 감싸 준다 -->
    <div class="connect">
    <fieldset class="kinds-set" aria-labelledby="kind-head">
      <div class="kinds">
        {c.kinds.map((k, i) => (
          <label class={`kind k${i}`}>
            <input type="radio" name="kind" value={k.title} checked={i === 0} />
            <span class="card">
              <img src={kindImgs[i]} alt="" width="720" height="720" loading="lazy" />
              <b>{k.title}</b>
              <small>{k.sub}</small>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- data-show: 이 묶음을 보여 줄 문의 종류 번호. 숨긴 묶음은 disabled로 검사와 메일 본문에서 빠진다 -->
    <div class="sheet"><div class="panel">
      <fieldset class="group" data-show="0">
        <legend class="label">{c.workLabel} <em class="mark">{c.optional}</em></legend>
        <div class="works">
          <label class="tile">
            <input type="radio" name="work" value="" data-name="" checked />
            <span class="pic none">{c.workNone}</span>
          </label>
          {WORKS.map((w) => (
            <label class="tile">
              <input type="radio" name="work" value={w.slug} data-name={w.name[lang]} />
              <span class="pic"><img src={w.icon} alt="" width="512" height="512" loading="lazy" /></span>
              <span class="name">{w.name[lang]}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="group row" data-show="0">
        <label class="field"><span class="label">{c.deviceLabel} <em class="mark">{c.optional}</em></span><input name="device" maxlength="500" data-label={c.deviceLabel} placeholder={c.devicePlaceholder} /></label>
        <label class="field"><span class="label">{c.versionLabel} <em class="mark">{c.optional}</em></span><input name="version" maxlength="500" data-label={c.versionLabel} placeholder={c.versionPlaceholder} /></label>
      </fieldset>

      <fieldset class="group" data-show="1">
        <legend class="label">{c.topicLabel}</legend>
        <div class="topics">
          {c.topics.map((tp, i) => (
            <label class="topic"><input type="radio" name="topic" value={tp} checked={i === 0} /><span>{tp}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="group" data-show="1">
        <label class="field"><span class="label">{c.companyLabel} <em class="mark on">{c.required}</em></span><input name="company" maxlength="500" data-label={c.companyLabel} autocomplete="organization" required /><small class="err" hidden></small></label>
      </fieldset>

      <div class="row">
        <label class="field"><span class="label">{c.nameLabel} <em class="mark">{c.optional}</em></span><input name="name" maxlength="200" autocomplete="name" /></label>
        <label class="field"><span class="label">{c.replyLabel} <em class="mark on">{c.required}</em></span><input name="reply" maxlength="254" type="email" autocomplete="email" required /><small class="err" hidden></small></label>
      </div>

      <label class="field">
        <span class="label">{c.messageLabel} <em class="mark on">{c.required}</em></span>
        <textarea name="message" maxlength="5000" rows="7" required aria-describedby="msg-hint"></textarea>
        <small class="err" hidden></small>
        <small id="msg-hint" data-hints={JSON.stringify(c.messageHints)}>{c.messageHints[0]}</small>
      </label>

      <!-- 사람에게는 안 보이는 칸. 봇이 채우면 수신기가 저장하지 않는다 -->
      <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="actions">
        <p class="note">{CONTACT_ENDPOINT ? c.sendNote : c.mailNote}</p>
        <div class="after" role="status" hidden>{c.mailAfter.map((line) => <p>{line}</p>)}</div>
        <p class="failed" role="alert" hidden>{c.sendFailed}</p>
        <button type="submit">{c.send}<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 11.5 21 3l-6.5 18-3.2-7.3L3 11.5Z M11.3 13.7 21 3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" /></svg></button>
      </div>
    </div></div>
    </div>

    <dialog class="sent-modal" aria-labelledby="sent-title">
      <img src="/img/envelope.png" alt="" width="120" height="120" />
      <h2 id="sent-title">{c.sent[0]}</h2>
      <p>{c.sent[1]}</p>
      <button type="button" class="sent-close">{c.sentClose}</button>
    </dialog>

    <div class="direct">
      <img src="/img/envelope.png" alt="" width="720" height="720" loading="lazy" />
      <div class="direct-copy">
        <h3>{c.directTitle}</h3>
        <div class="address">
          <a class="mail" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          <button type="button" class="copy-btn" data-copy={COMPANY.email} data-done={c.copied}>{c.copy}</button>
        </div>
        <p class="copy-failed" role="status" hidden>{c.copyFailed}</p>
      </div>
    </div>
  </form>
</main>
<SiteFooter lang={lang} />

<script>
  const form = document.querySelector<HTMLFormElement>('.form');

  // 게임·앱 상세의 고객지원 링크(?app=<slug>)로 들어오면 해당 게임·앱을 미리 고른다
  const app = new URLSearchParams(location.search).get('app');
  const preset = form?.querySelector<HTMLInputElement>(`input[name=work][value="${CSS.escape(app ?? '')}"]`);
  if (app && preset) preset.checked = true;

  // 문의 종류에 맞는 입력 묶음만 보이고, 내용 안내 문구도 바꾼다
  const kinds = [...(form?.querySelectorAll<HTMLInputElement>('input[name=kind]') ?? [])];
  const hint = form?.querySelector<HTMLElement>('#msg-hint');
  const hints: string[] = JSON.parse(hint?.dataset.hints ?? '[]');
  const applyKind = () => {
    const k = String(kinds.findIndex((r) => r.checked));
    form?.querySelectorAll<HTMLFieldSetElement>('.group').forEach((g) => {
      const on = (g.dataset.show ?? '').split(' ').includes(k);
      g.hidden = !on;
      g.disabled = !on;
    });
    if (hint) hint.textContent = hints[Number(k)] ?? '';
  };
  kinds.forEach((r) => r.addEventListener('change', applyKind));
  applyKind();

  // 브라우저 기본 말풍선 대신 칸 바로 아래 한 줄로 알린다
  const fieldError = (el: HTMLInputElement | HTMLTextAreaElement): string => {
    if (el.validity.valueMissing) return form?.dataset.errRequired ?? '';
    if (el.validity.typeMismatch) return form?.dataset.errEmail ?? '';
    return '';
  };
  const showError = (el: HTMLInputElement | HTMLTextAreaElement): boolean => {
    const msg = fieldError(el);
    const err = el.parentElement?.querySelector<HTMLElement>('.err');
    if (err) { err.textContent = msg; err.hidden = !msg; }
    el.toggleAttribute('aria-invalid', Boolean(msg));
    return !msg;
  };
  const required = () => [...(form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]') ?? [])]
    .filter((el) => !el.closest('fieldset[disabled]'));
  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) =>
    el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) showError(el); }));

  const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
  const sentBox = form?.querySelector<HTMLElement>('.after');
  const failedBox = form?.querySelector<HTMLElement>('.failed');
  const sentModal = document.querySelector<HTMLDialogElement>('.sent-modal');
  sentModal?.querySelector('.sent-close')?.addEventListener('click', () => sentModal.close());
  // 바깥(배경)을 눌러도 닫는다
  sentModal?.addEventListener('click', (e) => { if (e.target === sentModal) sentModal.close(); });

  // 숨긴 묶음(disabled)의 칸은 FormData에서 빠지므로 보이는 칸만 보낸다
  const collect = (f: HTMLFormElement) => {
    const data = new FormData(f);
    const text = (key: string) => String(data.get(key) ?? '').trim();
    const fields: Record<string, string> = {
      kind: text('kind'),
      topic: text('topic'),
      work: f.querySelector<HTMLInputElement>('.group:not([disabled]) input[name=work]:checked')?.dataset.name ?? '',
      company: text('company'),
      device: text('device'),
      version: text('version'),
    };
    const filled = Object.fromEntries(Object.entries(fields).filter(([, value]) => value !== ''));
    return {
      source: 'site',
      lang: f.dataset.lang ?? '',
      name: text('name'),
      reply: text('reply'),
      message: text('message'),
      fields: filled,
      extra: {},
      website: text('website'),
    };
  };

  // 본문을 text/plain으로 보내면 사전 요청(preflight) 없이 Apps Script에 닿는다
  const send = async (payload: ReturnType<typeof collect>): Promise<boolean> => {
    try {
      const res = await fetch(form?.dataset.endpoint ?? '', { method: 'POST', body: JSON.stringify(payload) });
      const result: unknown = await res.json();
      return typeof result === 'object' && result !== null && 'ok' in result && result.ok === true;
    } catch (err: unknown) {
      console.error('contact send failed', err);
      return false;
    }
  };

  // 수신기 주소가 아직 없으면 메일 앱으로 넘긴다
  const openMail = (f: HTMLFormElement) => {
    const data = new FormData(f);
    const work = f.querySelector<HTMLInputElement>('.group:not([disabled]) input[name=work]:checked')?.dataset.name ?? '';
    const kind = String(data.get('kind') ?? '');
    const topic = data.has('topic') ? String(data.get('topic')) : '';
    const subject = [f.dataset.prefix, kind, topic || work].filter(Boolean).join(' ');
    // 보이는 칸 중 값이 있는 것만 "이름: 값"으로 덧붙인다
    const extras = [...f.querySelectorAll<HTMLInputElement>('.group:not([disabled]) input[data-label]')]
      .filter((i) => i.value.trim())
      .map((i) => `${i.dataset.label}: ${i.value.trim()}`);
    const body = [
      String(data.get('message') ?? ''),
      '',
      '---',
      [kind, topic, work].filter(Boolean).join(' / '),
      ...extras,
      `${String(data.get('name') ?? '')} <${String(data.get('reply') ?? '')}>`,
    ].join('\n');
    location.href = `mailto:${f.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    // 메일 앱이 열렸는지, 실제로 보냈는지는 알 수 없으므로 완료라고 하지 않고 다음 할 일을 알린다
    if (sentBox) sentBox.hidden = false;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submit || submit.disabled) return;
    const invalid = required().filter((el) => !showError(el));
    if (invalid.length > 0) { invalid[0]?.focus(); return; }
    if (!form.dataset.endpoint) { openMail(form); return; }
    const label = submit.innerHTML;
    submit.disabled = true;
    submit.textContent = form.dataset.sending ?? '';
    if (failedBox) failedBox.hidden = true;
    const ok = await send(collect(form));
    submit.disabled = false;
    submit.innerHTML = label;
    if (ok) {
      // 같은 내용을 두 번 보내지 않게 적은 글만 비운다. 이름·이메일은 남겨 이어서 문의하기 쉽게 한다
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('textarea, .group input:not([type=radio])').forEach((el) => { el.value = ''; });
      sentModal?.showModal();
    } else if (failedBox) {
      failedBox.hidden = false;
    }
  });

  document.querySelector<HTMLButtonElement>('.copy-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      btn.textContent = btn.dataset.done ?? '';
    } catch {
      // 클립보드 권한이 없으면 주소를 선택해 두어 직접 복사하게 한다
      const mail = document.querySelector('.mail');
      if (mail) getSelection()?.selectAllChildren(mail);
      const failed = document.querySelector<HTMLElement>('.copy-failed');
      if (failed) failed.hidden = false;
    }
  });
</script>

<style>
  h1, h2 { font-family: var(--font-ko-display); font-weight: 400; }
  :global(html[lang='en']) h1, :global(html[lang='en']) h2 { font-family: var(--font-en-display); font-weight: 700; letter-spacing: -.02em; }

  /* 첫 화면: 큰 세 줄 문장과 종이비행기를 탄 마스코트 */
  .hero {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 20px;
    padding: 120px clamp(20px, 6vw, 96px) 130px; min-height: min(86svh, 800px); color: #fff;
    background:
      radial-gradient(rgba(255,255,255,.22) 2.5px, transparent 3.5px) 0 0 / 26px 26px,
      radial-gradient(circle at 75% 45%, rgba(255,214,102,.55), transparent 45%),
      var(--coral);
  }
  .copy { position: relative; z-index: 1; }
  .kicker {
    display: inline-block; margin: 0 0 18px; font-weight: 800; color: var(--ink); background: #fff; border: var(--line);
    border-radius: 99px; padding: 6px 18px; box-shadow: 3px 3px 0 var(--ink);
  }
  h1 { margin: 0; font-size: clamp(60px, 9.4vw, 148px); line-height: .98; text-shadow: 5px 5px 0 var(--ink); }
  h1 span { display: block; }
  /* 글꼴마다 위아래 여백 값이 달라 강조 상자 안 글자가 위나 아래로 쏠린다. 글자 높이만 남기고 여백을 똑같이 준다 */
  h1 .l1 {
    display: inline-block; margin: .1em 0; padding: .14em .14em; text-box: trim-both cap alphabetic; color: var(--ink); text-shadow: none; background: var(--sun);
    border: var(--line); border-radius: 24px; box-shadow: var(--pop); transform: rotate(2deg);
  }
  /* 영어 소문자는 g·y·p 꼬리가 기준선 아래로 내려가 아래 여백을 그만큼 더 준다 */
  :global(html[lang='en']) h1 .l1 { padding: .1em .14em .3em; }
  .lead { font-size: clamp(17px, 1.6vw, 21px); font-weight: 700; margin: 26px 0 0; max-width: 24em; }
  .flyer { width: 100%; max-width: 640px; justify-self: center; animation: glide 6s ease-in-out infinite; }
  @keyframes glide { 50% { transform: translate(-18px, -22px) rotate(-4deg); } }
  .edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; }

  .form { max-width: 1040px; margin: 0 auto; padding: 70px 20px 0; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; }
  h2 { margin: 0 0 32px; font-size: clamp(36px, 5vw, 68px); line-height: 1.08; }

  /* 문의 종류: 폴더 탭. 고른 탭이 폼 위로 이어지고 폼은 그 탭 색을 입는다 */
  .connect { max-width: 1000px; margin: 0 auto; }
  .form { --tab: var(--sky); }
  .form:has(.k1 input:checked) { --tab: #ffd0b8; }
  .form:has(.k2 input:checked) { --tab: #dff1ff; }
  .kinds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; align-items: end; }
  .kind input, .tile input { position: absolute; opacity: 0; pointer-events: none; }
  .card {
    display: grid; justify-items: center; text-align: center; gap: 4px; cursor: pointer;
    padding: 14px 18px 18px; border: 4px solid var(--ink); border-bottom: 0; border-radius: 32px 32px 0 0;
    filter: saturate(.75) brightness(.97); transition: filter .2s;
  }
  .k0 .card { background: var(--sky); }
  .k1 .card { background: #ffd0b8; }
  .k2 .card { background: #dff1ff; }
  .card img { width: 46%; transition: transform .25s cubic-bezier(.3, 1.6, .5, 1); }
  .card b { font: 400 clamp(20px, 2vw, 26px)/1.2 var(--font-ko-display); word-break: keep-all; }
  :global(html[lang='en']) .card b { font-family: var(--font-en-display); font-weight: 700; }
  .card small { font-weight: 700; font-size: 15px; opacity: .75; }
  .card:hover { filter: none; }
  .card:hover img { transform: translateY(-6px) rotate(-4deg); }
  /* 고른 탭만 아래로 4px 내려 폼 윗선을 덮어 한 덩어리가 되고, 나머지 탭은 폼 윗선 위에 얹힌다 */
  .kind input:checked + .card { position: relative; z-index: 1; filter: none; margin-bottom: -4px; padding-top: 26px; padding-bottom: 26px; }
  .kind input:checked + .card img { transform: scale(1.1) rotate(-3deg); }
  .kind input:focus-visible + .card { outline: 3px dashed var(--ink); outline-offset: -12px; }
  .tile input:focus-visible + * { outline: 3px solid var(--wave); outline-offset: 4px; }

  .sheet {
    background: var(--tab); border: 4px solid var(--ink); border-radius: 0 0 40px 40px; padding: clamp(12px, 2vw, 22px);
    box-shadow: 8px 8px 0 var(--ink);
    transition: background-color .2s;
  }
  .panel {
    display: grid; gap: 26px; background: #fff; border: 3px solid var(--ink); border-radius: 28px;
    padding: clamp(22px, 4vw, 44px);
  }
  .label { display: block; font-weight: 800; font-size: 17px; margin-bottom: 10px; }

  /* 관련 게임·앱: 아이콘을 눌러 고른다 */
  .works { display: flex; flex-wrap: wrap; gap: 12px; }
  .tile { cursor: pointer; }
  .tile { display: grid; justify-items: center; align-content: start; gap: 6px; width: 84px; text-align: center; }
  .tile:has(.none) { width: auto; }
  .pic {
    position: relative; display: grid; place-items: center; width: 68px; height: 68px; border: 3px solid var(--ink); border-radius: 22px;
    box-shadow: 3px 3px 0 var(--ink); transition: transform .15s cubic-bezier(.3, 1.6, .5, 1);
  }
  .pic img { width: 100%; height: 100%; border-radius: 19px; }
  .pic.none { width: auto; padding: 0 16px; font-weight: 800; font-size: 15px; background: var(--foam); }
  .name { font-size: 13px; font-weight: 700; line-height: 1.3; word-break: keep-all; }
  .tile:hover .pic { transform: translateY(-3px); }
  .tile input:checked + .pic { transform: translateY(-4px) rotate(-4deg); box-shadow: 0 0 0 4px var(--wave), 5px 6px 0 var(--ink); }
  /* 색만으로 고른 것을 알리지 않게 굵은 체크를 붙인다 */
  .tile input:checked + .pic::after {
    content: '✓'; position: absolute; right: -10px; top: -10px; width: 26px; height: 26px; display: grid; place-items: center;
    background: var(--wave); color: #fff; border: 3px solid var(--ink); border-radius: 50%; font-weight: 900; font-size: 14px;
  }
  .tile input:checked ~ .name { font-weight: 900; }
  .mark { font-style: normal; font-size: 12px; font-weight: 700; vertical-align: 2px; padding: 2px 8px; border-radius: 99px; background: var(--foam); border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent); }
  .mark.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .err { margin-top: 6px; color: #c62828; font-weight: 700; opacity: 1; }
  [aria-invalid] { border-color: #c62828 !important; }
  .after { flex-basis: 100%; order: 3; background: var(--sky); border: 2px solid var(--ink); border-radius: 16px; padding: 12px 16px; font-weight: 700; }
  .after p { margin: 0; }
  .sent-modal {
    width: min(420px, calc(100% - 32px)); padding: 28px 24px 24px; text-align: center; color: var(--ink);
    background: var(--sky); border: 4px solid var(--ink); border-radius: 28px; box-shadow: var(--pop);
  }
  .sent-modal::backdrop { background: color-mix(in srgb, var(--ink) 45%, transparent); }
  .sent-modal img { display: block; width: 96px; height: 96px; margin: 0 auto; }
  .sent-modal h2 { margin: 8px 0 10px; font-size: 24px; }
  .sent-modal p { margin: 0 0 22px; font-weight: 600; line-height: 1.6; word-break: keep-all; }
  .sent-close {
    cursor: pointer; min-width: 140px; color: #fff; font-family: inherit; font-size: 18px; font-weight: 700; line-height: 1; background: var(--wave);
    border: 3px solid var(--ink); border-radius: 99px; padding: 14px 28px; box-shadow: 4px 4px 0 var(--ink);
  }
  .sent-close:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }
  .failed { flex-basis: 100%; order: 3; margin: 0; background: #ffe1dc; border: 2px solid #c62828; border-radius: 16px; padding: 12px 16px; font-weight: 700; }
