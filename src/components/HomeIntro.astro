---
import type { Lang } from '../data/works';
import { WORKS } from '../data/works';
import { STRINGS } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = STRINGS[lang];

const ICON_COLUMNS = 8;
const ICONS_PER_COLUMN = 12;
const icons = WORKS.map((w) => w.icon);
const columns = Array.from({ length: ICON_COLUMNS }, (_, c) =>
  Array.from({ length: ICONS_PER_COLUMN }, (_, r) => icons[(c * 2 + r) % icons.length]),
);
---
<script is:inline>
  // 같은 세션에서 다시 홈에 오면 입장 화면을 건너뛴다
  try { if (sessionStorage.getItem('ww-entered')) document.documentElement.classList.add('entered'); } catch {}
</script>

<div class="intro" id="intro">
  <div class="wall" aria-hidden="true">
    {columns.map((col) => (
      <div class="col">{col.map((src) => <img src={src} alt="" width="120" height="120" loading="lazy" />)}</div>
    ))}
  </div>
  <div class="gate">
    <img class="gate-logo" src="/img/logo1.png" alt="WaveWorks" width="600" height="390" />
    <p class="gate-line">{t.tagline}</p>
    <button class="enter" id="enter" type="button">{t.enter}</button>
  </div>
</div>

<script>
  const intro = document.getElementById('intro');
  const SWIPE_MIN = 40;

  function enter() {
    if (!intro || intro.classList.contains('out') || document.documentElement.classList.contains('entered')) return;
    intro.classList.add('out');
    try { sessionStorage.setItem('ww-entered', '1'); } catch { /* 저장 못 해도 입장은 된다 */ }
  }

  document.getElementById('enter')?.addEventListener('click', enter);
  // 버튼 말고도 아래로 스크롤·쓸어 올리기·아래 방향 키로 들어간다
  addEventListener('wheel', (e) => { if (e.deltaY > 0) enter(); }, { passive: true });
  let touchY = 0;
  addEventListener('touchstart', (e) => { touchY = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', (e) => { if (touchY - e.touches[0].clientY > SWIPE_MIN) enter(); }, { passive: true });
  addEventListener('keydown', (e) => { if (['ArrowDown', 'PageDown', ' '].includes(e.key) && e.target === document.body) enter(); });
</script>

<style>
  /* 입장 화면 (111%의 아이콘 벽) */
  .intro {
    position: fixed; inset: 0; z-index: 40; background: var(--ink);
    display: grid; place-items: center; overflow: hidden;
    transition: transform .8s cubic-bezier(.7, 0, .2, 1);
  }
  .intro.out, :global(html.entered) .intro { transform: translateY(-100%); }
  :global(html.entered) .intro { transition: none; }
  /* 입장 화면이 덮여 있는 동안은 뒤쪽 홈 화면 스크롤바를 숨긴다 */
  :global(html:not(.entered):has(.intro:not(.out))) { overflow: hidden; }
  .wall { position: absolute; inset: -25%; display: flex; gap: 18px; justify-content: center; transform: rotate(-12deg); opacity: .5; }
  .col { display: flex; flex-direction: column; gap: 18px; animation: up 30s linear infinite; }
  .col:nth-child(even) { animation-name: down; }
  .col img { width: 120px; height: 120px; border-radius: 28px; border: 3px solid #fff; }
  @keyframes up { to { transform: translateY(-50%); } }
  @keyframes down { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  .gate { position: relative; text-align: center; }
  .gate-logo { width: min(440px, 78vw); margin: 0 auto 22px; animation: bob 3.2s ease-in-out infinite; }
  .gate-line {
    width: fit-content; max-width: min(30em, calc(100vw - 48px)); margin: 0 auto 24px; text-wrap: balance; padding: 8px 18px; font-weight: 800; font-size: clamp(15px, 1.8vw, 19px); line-height: 1.5;
    color: var(--ink); background: #fff; border: var(--line); border-radius: 18px; word-break: keep-all;
  }
  .enter {
    font: 700 22px var(--font-en-display); color: var(--ink); cursor: pointer;
    background: var(--sun); border: var(--line); border-radius: 99px; padding: 12px 44px;
    box-shadow: 0 6px 0 #0b1330; transition: transform .12s ease-out, box-shadow .12s ease-out;
  }
  .enter:hover { transform: translateY(-3px); box-shadow: 0 9px 0 #0b1330; }
  @keyframes bob { 50% { transform: translateY(-8px) rotate(-1deg); } }
</style>
