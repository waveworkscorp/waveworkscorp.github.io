---
import type { Lang } from '../data/works';
import { STRINGS, COMPANY, DEVELOPER_STORES, localePath } from '../data/i18n';
import StoreIcon from './StoreIcon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = STRINGS[lang];
// 스토어 개발자 페이지 버튼. 작품 상세의 스토어 카드를 작게 줄인 모양이다
const stores = [
  { key: 'play', label: 'Google Play', href: DEVELOPER_STORES.play },
  { key: 'apple', label: 'App Store', href: DEVELOPER_STORES.appStore },
] as const;
---
<footer class="site-footer">
  <div class="inner">
    <img class="logo" src="/img/logo1.png" alt="WaveWorks" width="600" height="390" />
    <nav class="links" aria-label={t.company}>
      <a href={localePath(lang, '/works/')}>Works</a>
      <a href={localePath(lang, '/about/')}>About</a>
      <a href={localePath(lang, '/contact/')}>Contact</a>
    </nav>
    <p class="biz">
      {COMPANY.name}, {t.rep} {COMPANY.rep[lang]}, {t.bizNo} {COMPANY.bizNo}<br />
      {t.mailOrder} {COMPANY.mailOrderNo}<br />
      {COMPANY.address[lang]}<br />
      <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
    </p>
    <p class="copy">© 2026 WaveWorks</p>
    <div class="side">
      {stores.map((s) => {
        const Tag = s.href ? 'a' : 'span';
        return (
          <Tag class:list={['store', s.key, { off: !s.href }]} href={s.href} target={s.href ? '_blank' : undefined}
            rel={s.href ? 'noopener' : undefined}>
            <span class="tile"><StoreIcon store={s.key} /></span>
            <span class="txt"><b>{s.label}</b>{!s.href && <small>{t.comingSoon}</small>}</span>
            {s.href && <span class="arr" aria-hidden="true">↗</span>}
          </Tag>
        );
      })}
      <img class="peek" src="/img/mascot-about.png" alt="" width="640" height="640" aria-hidden="true" />
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; margin-top: 140px; background: var(--ink); color: #fff; font-size: 14px; }
  @keyframes peek { 50% { transform: translateY(-10px) rotate(4deg); } }
  .inner { max-width: 1240px; margin: 0 auto; padding: 48px 20px 56px; display: grid; grid-template-columns: 1fr auto; gap: 18px 24px; }
  .inner > :not(.side) { grid-column: 1; }
  /* 오른쪽 아래: 왼쪽 열에 스토어 버튼 두 개, 오른쪽에 두 버튼 높이만 한 파도 캐릭터 */
  .side {
    grid-column: 2; grid-row: 1 / span 4; align-self: end;
    display: grid; grid-template-columns: auto auto; grid-template-areas: 'play peek' 'apple peek'; gap: 16px 18px; align-items: center;
  }
  .play { grid-area: play; }
  .apple { grid-area: apple; }
  .peek { grid-area: peek; width: auto; height: 164px; animation: peek 3s ease-in-out infinite; }
  .store {
    display: flex; align-items: center; gap: 14px; width: 240px; padding: 9px 18px 9px 9px;
    text-decoration: none; color: var(--ink); background: #fff;
    border: 3px solid var(--ink); border-radius: 20px; box-shadow: 5px 5px 0 var(--wave);
    transition: transform .12s ease-out, box-shadow .12s ease-out;
  }
  a.store:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--wave); }
  a.store:focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; }
  .store.off { opacity: .7; box-shadow: none; }
  .tile { display: grid; flex: none; width: 46px; height: 46px; padding: 8px; background: #fff; border: 2px solid var(--ink); border-radius: 13px; }
  .apple .tile { padding: 9px 9px 10px; color: #000; }
  .store .txt { flex: 1; display: grid; }
  .store b { font: 700 19px/1.2 var(--font-en-display); white-space: nowrap; }
  .store small { font-weight: 700; font-size: 13px; }
  .arr { font-size: 22px; font-weight: 800; opacity: .5; }
  /* 좁은 화면에서는 글 묶음 아래로 내린다 */
  @media (max-width: 760px) {
    .side { grid-column: 1; grid-row: auto; justify-self: start; }
  }
  @media (max-width: 420px) {
    .store { width: 220px; gap: 12px; }
    .store b { font-size: 16px; }
  }
  .logo { height: 52px; width: auto; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 26px; font: 600 17px var(--font-en-display); }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--sun); }
  .biz { margin: 0; opacity: .75; line-height: 1.8; }
  .copy { margin: 0; opacity: .55; }
</style>
