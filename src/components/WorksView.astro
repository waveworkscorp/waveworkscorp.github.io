---
import type { Category, Lang } from '../data/works';
import { WORKS, isAvailable, worksBy } from '../data/works';
import { STRINGS } from '../data/i18n';
import WorkCard from './WorkCard.astro';
import SiteFooter from './SiteFooter.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = STRINGS[lang];

// 공개한 웹 작품이 생기기 전까지 웹 탭은 숨기고 목록 아래 안내 카드로만 알린다
const hasWeb = worksBy('web').length > 0;
const tabs: readonly { key: Category | 'all'; label: string }[] = [
  { key: 'all', label: t.tabAll },
  { key: 'game', label: t.tabGame },
  { key: 'app', label: t.tabApp },
  ...(hasWeb ? [{ key: 'web' as const, label: t.tabWeb }] : []),
];
// 지금 받을 수 있는 작품과 준비 중인 작품을 나눠 설치하러 온 사람이 바로 찾게 한다
const groupsOf = (list: typeof WORKS) =>
  [
    { head: t.availableHead, items: list.filter(isAvailable) },
    { head: t.comingSoon, items: list.filter((w) => !isAvailable(w)) },
  ].filter((g) => g.items.length > 0);
---
<main>
  <section class="hero">
    <div class="copy">
      <p class="kicker">{t.worksTitle}</p>
      <h1>{t.worksHero.map((line, i) => <span class={`l${i}`}>{line}</span>)}</h1>
      <p class="lead">{t.worksLead}</p>
    </div>
    <div class="art" aria-hidden="true">
      <img class="island" src="/img/island-works.png" alt="" width="640" height="640" />
      <img class="buddy" src="/img/mascot-works.png" alt="" width="640" height="640" />
    </div>
    <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#fff" d="M0 80V40c120-36 240-36 360 0s240 36 360 0 240-36 360 0 240 36 360 0v40z" />
    </svg>
  </section>


  <div class="body">
    <div class="tabs" role="tablist" aria-label={t.worksTitle}>
      {tabs.map((tab, i) => (
        <a role="tab" href={`#${tab.key}`} id={`tab-${tab.key}`} aria-controls={tab.key} aria-selected={i === 0 ? 'true' : 'false'}>{tab.label}</a>
      ))}
    </div>

    {tabs.map((tab) => {
      const list = tab.key === 'all' ? WORKS : worksBy(tab.key);
      return (
        <section class="panel" id={tab.key} role="tabpanel" aria-labelledby={`tab-${tab.key}`}>
          {groupsOf(list).map((g) => (
            <div class="group">
              <h2 class="group-head">{g.head}<span>{g.items.length}</span></h2>
              <div class="grid">{g.items.map((w, i) => <WorkCard lang={lang} work={w} wide={i === 0 && g.items.length % 2 === 1} />)}</div>
            </div>
          ))}
        </section>
      );
    })}

    {!hasWeb && (
      <aside class="web-note">
        <img src="/img/mascot-about.png" alt="" width="640" height="640" />
        <div>
          <h2>{t.webEmptyTitle}</h2>
          <p>{t.webEmptyBody}</p>
          <p class="links"><a href="#game">{t.seeGames}</a><a href="#app">{t.seeApps}</a></p>
        </div>
      </aside>
    )}
  </div>
</main>
<SiteFooter lang={lang} />

<script>
  // 탭은 주소의 #all, #game, #app, #web과 맞물려 링크로 바로 열 수 있다. 스크립트가 없으면 전부 보인다
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.tabs [role=tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
  const show = (key: string) => {
    const target = panels.some((p) => p.id === key) ? key : panels[0]?.id;
    panels.forEach((p) => { p.hidden = p.id !== target; });
    tabs.forEach((a) => a.setAttribute('aria-selected', String(a.getAttribute('aria-controls') === target)));
  };
  tabs.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    const key = a.getAttribute('aria-controls') ?? '';
    history.replaceState(null, '', `#${key}`);
    show(key);
  }));
  show(location.hash.slice(1));
  // 안내 카드의 게임 보기·앱 보기 링크도 탭을 바꾼다
  window.addEventListener('hashchange', () => show(location.hash.slice(1)));
</script>

<style>
  /* 첫 화면: Contact와 같은 큰 세 줄 문장과 섬 그림 */
  .hero {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 20px;
    padding: 120px clamp(20px, 6vw, 96px) 130px; min-height: min(88svh, 820px);
    background:
      radial-gradient(rgba(255,255,255,.35) 2.5px, transparent 3.5px) 0 0 / 26px 26px,
      radial-gradient(circle at 74% 50%, rgba(255,255,255,.6), transparent 42%),
      var(--sky);
  }
  .copy { position: relative; z-index: 1; }
  .kicker {
    display: inline-block; margin: 0 0 18px; font-weight: 800; background: #fff; border: var(--line);
    border-radius: 99px; padding: 6px 18px; box-shadow: 3px 3px 0 var(--ink);
  }
  h1 { margin: 0; font: 400 clamp(60px, 9.4vw, 148px)/.98 var(--font-ko-display); }
  /* 영어는 한 줄이 한글보다 길어 같은 크기면 단어마다 줄이 바뀌고 강조 상자가 칸을 다 채운다 */
  :global(html[lang='en']) h1 { font-family: var(--font-en-display); font-weight: 700; letter-spacing: -.02em; font-size: clamp(40px, 5.6vw, 92px); }
  h1 span { display: block; }
  /* 글꼴마다 위아래 여백 값이 달라 강조 상자 안 글자가 위나 아래로 쏠린다. 글자 높이만 남기고 여백을 똑같이 준다 */
  h1 .l1 {
    display: inline-block; margin: .1em 0; padding: .14em .14em; text-box: trim-both cap alphabetic; background: var(--sun);
    border: var(--line); border-radius: 24px; box-shadow: var(--pop); transform: rotate(-2deg);
  }
  /* 영어 소문자는 g·y·p 꼬리가 기준선 아래로 내려가 아래 여백을 그만큼 더 준다 */
  :global(html[lang='en']) h1 .l1 { padding: .1em .14em .3em; }
  .lead { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; margin: 26px 0 0; max-width: 24em; }
  .art { position: relative; justify-self: center; width: min(100%, 560px); }
  .island { width: 100%; animation: drift 5s ease-in-out infinite; filter: drop-shadow(0 18px 0 rgba(22, 34, 79, .18)); }
  .buddy { position: absolute; left: -6%; bottom: -2%; width: 34%; animation: hop 2.8s ease-in-out infinite; }
  @keyframes drift { 50% { transform: translateY(-14px) rotate(-1.5deg); } }
  .edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; }


  .body { max-width: 1240px; margin: 0 auto; padding: 70px 20px 0; }
  .tabs { display: flex; gap: 10px; margin-bottom: 36px; }
  .tabs a {
    font: 700 20px var(--font-en-display); text-decoration: none;
    border: var(--line); border-radius: 99px; padding: 8px 26px; background: #fff; box-shadow: 4px 4px 0 var(--ink);
    transition: transform .12s ease-out;
  }
  :global(html[lang='ko']) .tabs a { font-family: var(--font-body); font-weight: 800; }
  .tabs a:hover { transform: translateY(-3px); }
  .tabs a[aria-selected='true'] { background: var(--ink); color: #fff; }
  .panel + .panel { margin-top: 60px; }
  .panel[hidden] + .panel, .panel + .panel[hidden] { margin-top: 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .group + .group { margin-top: 56px; }
  .group-head { display: flex; align-items: center; gap: 10px; margin: 0 0 20px; font: 800 24px/1.2 var(--font-body); }
  .group-head span { font-size: 15px; border: 2px solid var(--ink); border-radius: 99px; padding: 1px 10px; }
  .web-note {
    display: flex; align-items: center; gap: 20px; margin-top: 64px; padding: 20px 26px;
    border: 3px dashed var(--ink); border-radius: 28px; background: var(--foam);
  }
  .web-note img { width: 84px; flex: none; }
  .web-note h2 { margin: 0; font: 800 20px/1.3 var(--font-body); }
  .web-note p { margin: 4px 0 0; font-weight: 600; opacity: .8; }
  .web-note .links { display: flex; gap: 10px; margin-top: 12px; opacity: 1; }
  .web-note .links a { font-weight: 800; text-decoration: none; border: var(--line); border-radius: 99px; padding: 4px 16px; background: #fff; box-shadow: 3px 3px 0 var(--ink); }
  @keyframes hop { 50% { transform: translateY(-16px) rotate(4deg); } }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding: 100px 24px 100px; }
    .art { width: min(82%, 360px); margin-top: 36px; }
    .grid { grid-template-columns: 1fr; }
    .tabs a { padding: 7px 18px; font-size: 17px; }
  }
</style>
