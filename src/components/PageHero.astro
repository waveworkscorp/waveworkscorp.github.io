---
interface Props {
  title: string;
  lead: string;
  tone: string;
  art: string;
  mascot?: string;
  dark?: boolean;
}
const { title, lead, tone, art, mascot, dark = false } = Astro.props;
---
<section class:list={['page-hero', { dark }]} style={`--tone:${tone}`}>
  <div class="copy">
    <slot name="before" />
    <h1>{title}</h1>
    <p>{lead}</p>
    <slot />
  </div>
  <div class="art" aria-hidden="true">
    <img class="main" src={art} alt="" width="640" height="640" />
    {mascot && <img class="buddy" src={mascot} alt="" width="640" height="640" />}
  </div>
  <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path fill="#fff" d="M0 80V40c120-36 240-36 360 0s240 36 360 0 240-36 360 0 240 36 360 0v40z" />
  </svg>
</section>

<style>
  .page-hero {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 32px;
    min-height: min(78svh, 720px); padding: 120px clamp(20px, 6vw, 96px) 120px;
    background:
      radial-gradient(rgba(255,255,255,.35) 2.5px, transparent 3.5px) 0 0 / 26px 26px,
      radial-gradient(circle at 78% 52%, rgba(255,255,255,.55), transparent 42%),
      var(--tone);
  }
  .dark { color: #fff; }
  .copy { position: relative; z-index: 1; max-width: 640px; }
  h1 { margin: 0; font: 400 clamp(52px, 8vw, 120px)/1 var(--font-ko-display); }
  :global(html[lang='en']) h1 { font-family: var(--font-en-display); font-weight: 700; letter-spacing: -.02em; }
  p { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; margin: 20px 0 0; max-width: 24em; }
  .art { position: relative; justify-self: center; width: min(100%, 520px); }
  .main { width: 100%; animation: drift 5s ease-in-out infinite; filter: drop-shadow(0 18px 0 rgba(22, 34, 79, .18)); }
  .buddy { position: absolute; left: -8%; bottom: -4%; width: 38%; animation: hop 2.8s ease-in-out infinite; }
  @keyframes drift { 50% { transform: translateY(-14px) rotate(-1.5deg); } }
  @keyframes hop { 0%, 100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-26px) rotate(6deg); } }
  .edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; }

  @media (max-width: 860px) {
    .page-hero { grid-template-columns: 1fr; min-height: 0; padding: 100px 24px 90px; }
    .art { width: min(78%, 340px); }
  }
</style>
