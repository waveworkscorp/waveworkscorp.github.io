---
import type { MarkdownHeading } from 'astro';

interface Props { headings: readonly MarkdownHeading[]; label: string }
const { headings, label } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  <>
    <details class="toc toc-top">
      <summary>{label}</summary>
      <ol>{items.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
    <nav class="toc toc-side" aria-label={label}>
      <p>{label}</p>
      <ol>{items.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a></li>)}</ol>
    </nav>
  </>
)}

<script>
  // 옆 목차에서 지금 읽는 제목을 표시한다
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc-side a')].map((a) => [a.dataset.slug ?? '', a]));
  const seen = new IntersectionObserver((entries) => {
    entries.filter((e) => e.isIntersecting).forEach((e) => {
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(e.target.id)?.setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-100px 0px -70% 0px' });
  links.forEach((_, slug) => { const h = document.getElementById(slug); if (h) seen.observe(h); });
</script>

<style>
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .toc a { text-decoration: none; font-weight: 600; font-size: 15px; line-height: 1.4; opacity: .75; }
  .toc a:hover, .toc a[aria-current] { opacity: 1; color: var(--wave); }
  .toc .d3 { padding-left: 14px; }
  .toc .d3 a { font-size: 14px; }
  .toc-top { margin: 0 0 28px; border: var(--line); border-radius: 20px; padding: 10px 18px; background: var(--foam); }
  .toc-top summary { font-weight: 800; cursor: pointer; }
  .toc-top ol { margin-top: 10px; }
  .toc-side { display: none; }
  .toc-side p { margin: 0 0 10px; font-weight: 800; }
  /* 넓은 화면은 본문 옆에 붙어 따라오고, 좁은 화면은 본문 위에 접어 둔다 */
  @media (min-width: 1100px) {
    .toc-top { display: none; }
    .toc-side {
      display: block; position: sticky; top: 110px; grid-column: 2; grid-row: 1; align-self: start;
      max-height: calc(100svh - 140px); overflow-y: auto; padding-left: 18px; border-left: 3px solid var(--ink);
    }
  }
</style>
