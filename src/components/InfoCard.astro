---
import type { InfoBox, Lang } from '../data/works';

interface Props { box: InfoBox; lang: Lang }
const { box, lang } = Astro.props;
---
<section class="info">
  <h3>{box.title[lang]}</h3>
  <dl>
    {box.rows.map((r) => (
      <div><dt>{r.label[lang]}</dt><dd>{r.value[lang]}</dd></div>
    ))}
  </dl>
</section>

<style>
  .info { margin: 0 0 70px; background: #fff; border: var(--line); border-radius: 26px; box-shadow: var(--pop); padding: 24px 28px; max-width: 860px; }
  .info + .info, :global(.features) + .info { margin-top: 40px; }
  h3 { margin: 0 0 12px; font-size: 21px; }
  dl { margin: 0; display: grid; }
  dl div { display: grid; grid-template-columns: 9em 1fr; gap: 16px; padding: 11px 0; border-top: 1.5px dashed color-mix(in srgb, var(--ink) 22%, transparent); }
  dt { font-weight: 800; }
  dd { margin: 0; font-weight: 500; line-height: 1.55; }
  @media (max-width: 560px) {
    .info { padding: 20px; }
    dl div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
